@page "/admin/preparate/editeaza/{id:int}"
@model MonAmourBistro.Pages.Admin.Preparate.EditModel
@{
    ViewData["Title"] = "Editează preparat";
}

<partial name="_AdminTabs" />

<div class="admin-form-box">
    <p class="muted"><span class="req">*</span> câmpuri obligatorii</p>

    <form method="post" class="auth-form admin-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label" for="idPreparat">Identificator (nu se modifică)</label>
            <input id="idPreparat" value="@Model.Preparat.Id" class="form-control" readonly disabled />
        </div>

        <div class="mb-3">
            <label asp-for="Preparat.Denumire" class="form-label"></label> <span class="req">*</span>
            <input asp-for="Preparat.Denumire" class="form-control" />
            <span asp-validation-for="Preparat.Denumire" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Preparat.Categorie" class="form-label"></label> <span class="req">*</span>
            <select asp-for="Preparat.Categorie" asp-items="Model.Categorii" class="form-select form-control">
                <option value="">— alegeți —</option>
            </select>
            <span asp-validation-for="Preparat.Categorie" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Preparat.Descriere" class="form-label"></label>
            <textarea asp-for="Preparat.Descriere" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Preparat.Descriere" class="field-error"></span>
        </div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="Preparat.Pret" class="form-label"></label> <span class="req">*</span>
                <input asp-for="Preparat.Pret" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Preparat.Pret" class="field-error"></span>
            </div>
            <div class="col-sm-6 mb-3">
                <label asp-for="Preparat.Gramaj" class="form-label"></label> <span class="req">*</span>
                <input asp-for="Preparat.Gramaj" type="number" step="1" class="form-control" />
                <span asp-validation-for="Preparat.Gramaj" class="field-error"></span>
            </div>
        </div>

        <div class="form-check mb-4">
            <input asp-for="Preparat.Disponibil" class="form-check-input" />
            <label asp-for="Preparat.Disponibil" class="form-check-label"></label>
        </div>

        <div class="admin-form-buttons">
            <button type="submit" class="btn-outline-dark-x mt-0 bg-transparent">Salvează modificările</button>
            <a href="/admin/preparate" class="btn-outline-dark-x mt-0 btn-cancel">Anulează</a>
        </div>
    </form>
</div>
